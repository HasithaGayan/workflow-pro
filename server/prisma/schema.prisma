generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model app_users {
  user_id               BigInt                  @id @default(autoincrement())
  full_name             String                  @db.VarChar(120)
  email                 String                  @unique @db.VarChar(255)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  auth_credentials      auth_credentials?
  auth_sessions         auth_sessions[]
  tasks                 tasks[]
  workspace_memberships workspace_memberships[]
}

model projects {
  project_id   BigInt     @id @default(autoincrement())
  workspace_id BigInt
  name         String     @db.VarChar(150)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  workspaces   workspaces @relation(fields: [workspace_id], references: [workspace_id], onDelete: NoAction, onUpdate: NoAction)
  tasks        tasks[]

  @@unique([workspace_id, name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tasks {
  task_id          BigInt     @id @default(autoincrement())
  project_id       BigInt
  assigned_user_id BigInt?
  title            String     @db.VarChar(200)
  status           String     @default("todo") @db.VarChar(20)
  priority         String     @default("medium") @db.VarChar(10)
  due_date         DateTime?  @db.Date
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  app_users        app_users? @relation(fields: [assigned_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  projects         projects   @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model workspace_memberships {
  workspace_id BigInt
  user_id      BigInt
  role         String     @db.VarChar(10)
  app_users    app_users  @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  workspaces   workspaces @relation(fields: [workspace_id], references: [workspace_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspace_id, user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model workspaces {
  workspace_id          BigInt                  @id @default(autoincrement())
  name                  String                  @db.VarChar(120)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  projects              projects[]
  workspace_memberships workspace_memberships[]
}

model auth_credentials {
  user_id       BigInt    @id
  password_hash String
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  app_users     app_users @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auth_sessions {
  session_id BigInt    @id @default(autoincrement())
  user_id    BigInt
  token_hash String    @unique @db.VarChar(64)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  app_users  app_users @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_auth_sessions_expiry")
  @@index([user_id], map: "idx_auth_sessions_user")
}

model auth_rate_limits {
  rate_key String   @id @db.VarChar(128)
  hits     Int
  reset_at DateTime @db.Timestamptz(6)

  @@index([reset_at], map: "idx_auth_rate_limits_reset")
}
