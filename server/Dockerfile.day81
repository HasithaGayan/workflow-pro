# HGBP Day 81: TypeScript Express + Prisma 7, local-only proof container.
# Node.js 22 Debian provides libc compatibility for the native Argon2 package.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY prisma ./prisma
COPY prisma7.config.ts ./prisma7.config.ts
# Prisma 7 requires explicit client generation; its current client is TS source.
RUN ./node_modules/.bin/prisma generate --schema=prisma/schema.prisma
COPY src ./src
COPY tsconfig.json ./tsconfig.json
ENV NODE_ENV=development
USER node
EXPOSE 4000
CMD ["node", "--import", "tsx", "src/index.ts"]
